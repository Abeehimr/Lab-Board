# Generate a long random value for JWT_SECRET (32+ characters).
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# The only administrator password; no account creation or password reset exists.
ADMIN_PASSWORD=replace-with-a-strong-password
COOKIE_SECURE=false
DATABASE_URL=sqlite+aiosqlite:///./data/labboard.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
MAX_ATTACHMENTS=5
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_WINDOW_SECONDS=60
